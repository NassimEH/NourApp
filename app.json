{
  "expo": {
    "name": "NourApp",
    "slug": "nourapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nourapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nourapp.app"
    },
    "android": {
      "package": "com.nourapp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Position utilisee pour les horaires des prieres."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./fonts2/PlusJakartaSans-Bold.ttf",
            "./fonts2/PlusJakartaSans-ExtraBold.ttf",
            "./fonts2/PlusJakartaSans-Light.ttf",
            "./fonts2/PlusJakartaSans-Medium.ttf",
            "./fonts2/PlusJakartaSans-Regular.ttf",
            "./fonts2/PlusJakartaSans-SemiBold.ttf"
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "nourapp-local"
      }
    }
  }
}
