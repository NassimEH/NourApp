# Supabase — copiez vers .env.local et remplissez depuis le tableau de bord Supabase
# Project Settings → API → Project URL + anon public key

EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Auth Google (optionnel) : Authentication → Providers → Google
# Redirect URL à ajouter dans Supabase : nourapp:// (schéma défini dans app.json)
